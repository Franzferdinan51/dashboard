<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent template. install_bridge.sh substitutes __HOME__ with the
     installing user's home directory. Do not hardcode a real home path here. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.dashboard-bridge</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>DASHBOARD_MACHINE_NAME</key>
        <string>Mac Studio</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/dashboard-bridge/dashboard_bridge.py</string>
        <string>--port</string>
        <string>8901</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/dashboard-bridge/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/dashboard-bridge/bridge.err.log</string>
</dict>
</plist>
