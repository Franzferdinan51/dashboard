<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy dashboard gauge mark: an arc gauge with needle + hub, Muse blue on
     deep navy. Drawn in the 108dp adaptive-icon viewport with safe margins. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- gauge arc track -->
    <path
        android:pathData="M30,74 A30,30 0 1,1 78,74"
        android:strokeColor="#FF2A4A73"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- gauge arc value (electric blue) -->
    <path
        android:pathData="M30,74 A30,30 0 1,1 66,29.5"
        android:strokeColor="#FF1877F2"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- tick marks -->
    <path
        android:pathData="M33,68 L37.5,64.5 M54,39 L54,45 M75,68 L70.5,64.5"
        android:strokeColor="#FFF4F8FF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- needle -->
    <path
        android:pathData="M54,60 L66,42"
        android:strokeColor="#FFF4F8FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- hub -->
    <path
        android:pathData="M54,54 m-5.5,0 a5.5,5.5 0 1,1 11,0 a5.5,5.5 0 1,1 -11,0"
        android:fillColor="#FF1877F2" />
    <path
        android:pathData="M54,54 m-2.4,0 a2.4,2.4 0 1,1 4.8,0 a2.4,2.4 0 1,1 -4.8,0"
        android:fillColor="#FFF4F8FF" />
    <!-- base bars (mini bar chart under the gauge) -->
    <path
        android:pathData="M38,86 h7 M47.5,86 h7 M57,86 h7 M66.5,86 h7"
        android:strokeColor="#FF1877F2"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
